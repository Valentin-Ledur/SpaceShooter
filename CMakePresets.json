{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows",
            "displayName": "Windows",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "linux-python-AI",
            "displayName": "Linux-Python-AI",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_FEATURES": "python",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "PYTHON": true
            }
        },
        {
            "name": "windows-python-AI",
            "displayName": "Windows-Python-AI",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_FEATURES": "python",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "PYTHON": true
            }
        },
        {
            "name": "web",
            "displayName": "Web (Emscripten)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_web",
            "environment": {
                "PATH": "$env{EMSDK}/upstream/emscripten;$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
                "CMAKE_CROSSCOMPILING_EMULATOR": "$env{EMSDK}/node/22.16.0_64bit/bin/node.exe"
            }
        }
    ]
}